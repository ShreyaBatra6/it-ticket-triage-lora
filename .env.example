# Copy to .env and fill in. .env is gitignored - never commit real tokens.

# Hugging Face write token: https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: only needed for `python data_prep.py --llm` (LLM-generated tickets).
ANTHROPIC_API_KEY=

# Optional: only needed for `python train_lora.py --wandb`.
WANDB_API_KEY=

# Windows only: silences the Hub cache symlink warning.
HF_HUB_DISABLE_SYMLINKS_WARNING=1
